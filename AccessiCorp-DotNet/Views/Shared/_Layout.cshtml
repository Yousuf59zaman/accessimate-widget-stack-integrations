<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AccessiCorp ASP.NET Core</title>

    <!-- Modern Typography & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/primeicons@6.0.0/primeicons.css">
    
    <!-- Tailwind CSS Play CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- AccessiMate Accessibility Widget Script injected in ASP.NET Core Razor Layout -->
    <script type="module" 
            src="https://dev-script.accessimate.com/js/main.js" 
            data-account="yUkg0nklTJ3PsHOUOqUsT3HQw1bmfAWq0E1lCcWJ">
    </script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-sky-500 selection:text-white min-h-screen flex flex-col justify-between">
    
    <!-- Navbar -->
    <header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-slate-950/80 border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                
                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 group">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-sky-500/20 group-hover:scale-105 transition-transform">
                        <i class="pi pi-code text-xl"></i>
                    </div>
                    <div>
                        <span class="text-xl font-black text-white tracking-tight flex items-center gap-1">
                            Accessi<span class="text-gradient-sky">Corp</span>
                        </span>
                        <span class="text-[10px] font-bold tracking-wider text-sky-400 uppercase block -mt-1">
                            ASP.NET Core 8.0 MVC Portal
                        </span>
                    </div>
                </a>

                <!-- Navigation Links -->
                <nav class="hidden md:flex items-center gap-1 bg-slate-900/60 p-1.5 rounded-2xl border border-slate-800/80">
                    <a asp-controller="Home" asp-action="Index" class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-slate-300 hover:text-white hover:bg-slate-800/50">
                        <i class="pi pi-home"></i> Home
                    </a>

                    <a asp-controller="Home" asp-action="Services" class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-slate-300 hover:text-white hover:bg-slate-800/50">
                        <i class="pi pi-file"></i> Apply Online
                    </a>

                    <a asp-controller="Home" asp-action="Directory" class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-slate-300 hover:text-white hover:bg-slate-800/50">
                        <i class="pi pi-users"></i> Directory & Lookup
                    </a>

                    <a asp-controller="Home" asp-action="Faqs" class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-slate-300 hover:text-white hover:bg-slate-800/50">
                        <i class="pi pi-question-circle"></i> FAQs
                    </a>

                    <a asp-controller="Home" asp-action="Audit" class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-slate-300 hover:text-white hover:bg-slate-800/50">
                        <i class="pi pi-sliders-h text-sky-400"></i> Audit Suite
                    </a>
                </nav>

                <!-- Right Theme Toggle -->
                <div class="flex items-center gap-3">
                    <button onclick="toggleDotNetTheme()" class="p-2.5 rounded-xl bg-slate-900 text-slate-300 border border-slate-800 hover:text-white transition-all flex items-center gap-2 text-xs font-bold">
                        <i id="themeIcon" class="pi pi-sun text-amber-400"></i>
                        <span id="themeLabel">Light Mode</span>
                    </button>
                </div>

            </div>
        </div>
    </header>

    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-900 py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6 border-b border-slate-900 pb-8 mb-8">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center font-bold">
                        <i class="pi pi-code"></i>
                    </div>
                    <div>
                        <span class="text-lg font-black text-white">AccessiCorp</span>
                        <p class="text-xs text-slate-400">Official AccessiMate Widget Testbed (ASP.NET Core 8.0 MVC)</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 text-xs font-semibold text-slate-400">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        <i class="pi pi-shield"></i> WCAG 2.1 Level AA Target
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20">
                        ASP.NET Core 8.0 MVC
                    </span>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
                <p>© 2026 AccessiCorp Enterprise Portal. Powered by AccessiMate Accessibility Engine.</p>
                <p class="flex items-center gap-1">
                    Crafted for accessible C# web applications.
                </p>
            </div>
        </div>
    </footer>

    <script>
    function toggleDotNetTheme() {
        const html = document.documentElement;
        const isDark = html.classList.contains('dark');
        if (isDark) {
            html.classList.remove('dark');
            html.classList.add('light');
            document.getElementById('themeIcon').className = 'pi pi-moon text-sky-400';
            document.getElementById('themeLabel').innerText = 'Dark Mode';
        } else {
            html.classList.remove('light');
            html.classList.add('dark');
            document.getElementById('themeIcon').className = 'pi pi-sun text-amber-400';
            document.getElementById('themeLabel').innerText = 'Light Mode';
        }
    }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
